<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LisTube.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="LisTube.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="LisTube - YouTube Playlist Downloader"
        Width="900"
        Height="650"
        MinWidth="700"
        MinHeight="500">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Home" Command="{Binding NavigateHomeCommand}" />
            <MenuItem Header="_Queue" Command="{Binding NavigateQueueCommand}" />
            <MenuItem Header="_Settings" Command="{Binding NavigateSettingsCommand}" />
            <MenuItem Header="_About" Command="{Binding NavigateAboutCommand}" />
            <MenuItem Header="_Help" Command="{Binding NavigateHelpCommand}" />
        </Menu>

        <!-- Main Content Area -->
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
