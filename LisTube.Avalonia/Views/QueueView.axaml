<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LisTube.Avalonia.ViewModels"
             xmlns:models="using:LisTube.Avalonia.Models"
             x:Class="LisTube.Avalonia.Views.QueueView"
             x:DataType="vm:QueueViewModel">
    <Border Background="#2D2D30" Padding="20">
        <Grid RowDefinitions="Auto, *">
            <TextBlock Text="Gerenciador de Fila (Batch Download)" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" />
            
            <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:PlaylistDownloadTask">
                        <Border Background="#3D3D42" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="White" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#AAAAAA" />
                                    <ProgressBar Value="{Binding Progress}" Height="8" Margin="0,5,0,0" Background="#1E1E1E" Foreground="#007ACC" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#007ACC" FontWeight="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
