<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="BackgroundBrush">#2D2D30</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceBrush">#3E3E42</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#007ACC</SolidColorBrush>
        <SolidColorBrush x:Key="TextBrush">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SecondaryTextBrush">#AAAAAA</SolidColorBrush>
    </Styles.Resources>
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="#005A9E" />
    </Style>

    <!-- TextBox Style -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="#3E3E42" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- CheckBox Style -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- ListBox Style -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="BorderBrush" Value="#3E3E42" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="#3E3E42" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Menu Style -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Window Style -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

</Styles>
